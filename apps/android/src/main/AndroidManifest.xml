<?xml version="1.0" encoding="utf-8"?>
<!-- PhotoCraft Mobile: MainActivity (a GameActivity subclass) running the Rust library `libphotocraft_mobile.so`
     with immersive full screen and palm rejection. Built by `cargo xtask android`. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- wgpu draws with Vulkan, or OpenGL ES 3 where there is no Vulkan. -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:label="PhotoCraft Mobile"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:largeHeap="true"
        android:theme="@style/Theme.PhotoCraftMobile">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|density|uiMode|fontScale"
            android:windowSoftInputMode="stateHidden|adjustResize">
            <meta-data android:name="android.app.lib_name" android:value="photocraft_mobile" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Open with": images, and Photoshop documents under the other types they travel as. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/x-photoshop" />
                <data android:mimeType="application/photoshop" />
                <data android:mimeType="application/psd" />
            </intent-filter>
            <!-- "Share" from another app: one image or several. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/x-photoshop" />
                <data android:mimeType="application/photoshop" />
                <data android:mimeType="application/psd" />
            </intent-filter>
        </activity>
        <!-- Images exported for the share sheet (res/xml/file_paths.xml). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
